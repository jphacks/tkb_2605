# Copy to .env for local development (optional) or to /srv/workout/.env on the production VM.
# Never commit real values.

# --- development (optional; compose.yaml works without a .env) ---
# CHOKIDAR_USEPOLLING=true   # Windows/Docker Desktop if hot reload does not pick up changes

# --- production (/srv/workout/.env, root:docker 0640) ---
IMAGE_TAG=latest
PUBLIC_HOST=kintore.reindeer39.dev
DJANGO_SECRET_KEY=change-me-run-python3-c-import-secrets-print-secrets.token_urlsafe-50
TUNNEL_TOKEN=paste-cloudflare-tunnel-token
DATA_DIR=/srv/workout/data
BACKUP_DIR=/srv/workout/backup
# Optional off-site copy (Cloudflare R2 via rclone remote "r2"); leave empty to keep backups local only
R2_REMOTE=
AGE_RECIPIENTS_FILE=/srv/workout/age-recipients.txt
# Optional Discord webhook URL: ops/auto-deploy.sh posts "deployed <sha>" / "deploy failed" there
DEPLOY_NOTIFY_URL=
